{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": ["plugin:@ngrx/signals/recommended"],
      "rules": {
        "@ngrx/with-state-no-arrays-at-root": "error",
        "@ngrx/with-state-requires-initial-value": "error",
        "@ngrx/prefix-selectors-with-select": "off"
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"]
    }
  ]
}
