    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@microsoft/signalr": "^8.0.29",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "angular-auth-oidc-client": "^17.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@ngrx/eslint-plugin": "^18.1.1",
    "@testing-library/angular": "^19.4.2",
    "@types/node": "^22.20.1",
