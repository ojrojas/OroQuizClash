@using PlayersModels = QuizArena.Admin.Client.Models.Players

<div class="player-profile-card" role="region" aria-label="Perfil del jugador" style="display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-4);background:var(--color-card);border:var(--component-card-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);">
    @if (IsLoading)
    {
        <LoadingSkeleton Rows="4" />
    }
    else if (Detail is null)
    {
        <EmptyState Title="Sin datos" Message="No se encontró el perfil." />
    }
    else
    {
        <div style="display:flex;gap:var(--space-4);align-items:center;flex-wrap:wrap;">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--color-primary);color:var(--color-on-primary);display:flex;align-items:center;justify-content:center;font-weight:600;" aria-hidden="true">
                @(Detail.DisplayName.Length >= 2 ? Detail.DisplayName[..2].ToUpperInvariant() : Detail.DisplayName.ToUpperInvariant())
            </div>
            <div style="flex:1;min-width:200px;">
                <h2 style="margin:0;font-size:var(--typography-title-m);color:var(--color-card-foreground);">@Detail.DisplayName</h2>
                <p style="margin:0;color:var(--color-muted-foreground);font-size:var(--typography-label-m);">@Detail.Email</p>
                @if (!string.IsNullOrWhiteSpace(Detail.TenantId))
                {
                    <p style="margin:0;color:var(--color-muted-foreground);font-size:var(--typography-caption);">Tenant: @Detail.TenantId</p>
                }
            </div>
            <PlayerStateBadge State="@Detail.State" />
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-3);">
            <div><strong style="font-size:var(--typography-caption);color:var(--color-muted-foreground);">Identificación</strong><div aria-live="polite">@(Detail.IdentificationType ?? "—") @(Detail.IdentificationValue ?? "")</div></div>
            <div><strong style="font-size:var(--typography-caption);color:var(--color-muted-foreground);">Creado</strong><div>@Detail.CreatedAt.ToString("dd/MM/yyyy")</div></div>
            <div><strong style="font-size:var(--typography-caption);color:var(--color-muted-foreground);">Última actividad</strong><div>@(Detail.LastActiveAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
            <div><strong style="font-size:var(--typography-caption);color:var(--color-muted-foreground);">Participaciones</strong><div>@Detail.TotalParticipations</div></div>
        </div>

        <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;padding:var(--space-3);background:var(--color-muted);border-radius:var(--radius-md);">
            <span><strong>Total:</strong> @Detail.ScoreSummary.TotalPoints</span>
            <span><strong>Asegurados:</strong> @Detail.ScoreSummary.SecuredPoints</span>
            <span><strong>Disponibles:</strong> @Detail.ScoreSummary.AvailablePoints</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div role="alert" aria-live="assertive" style="color:var(--color-destructive-text);background:var(--color-muted);padding:var(--space-3);border-radius:var(--radius-md);">@Error</div>
        }
    }
</div>

@code {
    [Parameter] public PlayersModels.PlayerDetail? Detail { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Error { get; set; }
}
