@namespace QuizArena.Admin.Client.Shared

<button type="@Type" class="quiz-btn quiz-btn-@Variant quiz-btn-@Size @(Loading ? "is-loading" : string.Empty)"
        disabled="@(Disabled || Loading)" aria-disabled="@(Disabled || Loading)" aria-busy="@Loading"
        @onclick="HandleClick" @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="quiz-btn-spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <LucideIcon Name="@Icon" />
    }
    <span class="quiz-btn-label">@ChildContent</span>
</button>

@code {
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Task HandleClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs args) =>
        Disabled || Loading ? Task.CompletedTask : OnClick.InvokeAsync(args);
}
