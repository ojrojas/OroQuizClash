@page "/admin/rewards"
@attribute [Authorize(Policy = AdminPolicies.RewardManagerOrAdmin)]
@using RewardsModels = QuizArena.Admin.Client.Models.Rewards
@using QuizArena.Admin.Client.Services
@inject IRewardsService RewardsService
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Premios — QuizArena Admin</PageTitle>

<h1>Premios</h1>

<div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:end;margin-bottom:var(--space-4);">
    <QuizSelect Id="filter-type" Label="Tipo" Value="@selectedType" ValueChanged="OnTypeChanged" Options="@typeOptions" Placeholder="Todos" />
    <QuizSelect Id="filter-status" Label="Estado" Value="@selectedStatus" ValueChanged="OnStatusChanged" Options="@statusOptions" Placeholder="Todos" />
    <QuizInput Id="filter-search" Label="Buscar" Value="@search" ValueChanged="@(v => search = v ?? string.Empty)" Placeholder="Nombre" />
    <label style="display:flex;gap:var(--space-2);align-items:center;"><input type="checkbox" checked="@onlyEligible" @onchange="OnEligibleChanged" /> Solo elegibles</label>
    <QuizButton Variant="primary" OnClick="() => LoadAsync()" style="min-height:44px;">Buscar</QuizButton>
    <QuizButton Variant="primary" OnClick='() => Navigation.NavigateTo("/admin/rewards/new")' style="min-height:44px;">Crear premio</QuizButton>
    <a href="/admin/rewards/redemptions" style="margin-left:auto;">Ver canjes →</a>
</div>

@if (state == PageState.Loading)
{
    <LoadingSkeleton Rows="6" />
}
else if (state == PageState.Error)
{
    <ErrorState Message="@error" OnRetry="LoadAsync" />
}
else if (rewards.Count == 0)
{
    <EmptyState Title="Sin premios" Message="No hay premios con esos filtros." />
}
else
{
    <QuizTable Caption="Premios" ColumnCount="6" IsEmpty="@(rewards.Count==0)">
        <HeaderCells><th>Nombre</th><th>Tipo</th><th>Costo</th><th>Stock</th><th>Estado</th><th></th></HeaderCells>
        <BodyRows>
            @foreach (var r in rewards)
            {
                <tr>
                    <td>@r.Name</td>
                    <td><QuizBadge Variant="neutral" Label="@RewardsModels.RewardTypeMap.DisplayName(r.Type)" /></td>
                    <td>@r.Cost</td>
                    <td>
                        @if (r.Stock == 0 && RewardsModels.RewardTypeMap.IsStockUnlimitedAllowed(r.Type))
                        { <QuizBadge Variant="info" Label="Ilimitado" /> }
                        else if (r.Stock == 0) { <QuizBadge Variant="destructive" Label="Sin stock" /> }
                        else { @r.Stock }
                    </td>
                    <td>
                        <QuizBadge Variant="@(r.Status==RewardsModels.RewardStateView.Active?"success":r.Status==RewardsModels.RewardStateView.Archived?"neutral":"warning")" Label="@RewardsModels.RewardStateMap.DisplayName(r.Status)" />
                        @if (r.IsEligible) { <QuizBadge Variant="success" Label="Elegible" /> } else if (r.Status==RewardsModels.RewardStateView.Active) { <QuizBadge Variant="warning" Label="No elegible" /> }
                    </td>
                    <td style="display:flex;gap:var(--space-2);flex-wrap:wrap;">
                        <QuizButton Size="sm" Variant="ghost" OnClick='() => Navigation.NavigateTo($"/admin/rewards/{r.Id}/edit")' style="min-height:44px;">Editar</QuizButton>
                        @if (r.Status == RewardsModels.RewardStateView.Inactive)
                        { <QuizButton Size="sm" Variant="primary" OnClick="() => Activate(r)" style="min-height:44px;">Activar</QuizButton> }
                        else if (r.Status == RewardsModels.RewardStateView.Active)
                        { <QuizButton Size="sm" Variant="ghost" OnClick="() => Deactivate(r)" style="min-height:44px;">Desactivar</QuizButton> }
                    </td>
                </tr>
            }
        </BodyRows>
    </QuizTable>
    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-4);">
        <QuizButton Variant="ghost" Disabled="@(currentPage<=1)" OnClick="() => ChangePage(currentPage-1)" style="min-height:44px;">Anterior</QuizButton>
        <span>P&#225;gina @(currentPage) de @(totalPages) (@(totalCount) total)</span>
        <QuizButton Variant="ghost" Disabled="@(currentPage>=totalPages)" OnClick="() => ChangePage(currentPage+1)" style="min-height:44px;">Siguiente</QuizButton>
    </div>
}

@code {
    private enum PageState { Loading, Ready, Empty, Error }
    private PageState state = PageState.Loading;
    private string error = string.Empty;
    private IReadOnlyList<RewardsModels.RewardSummary> rewards = [];
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => pageSize <=0 ? 0 : (int)Math.Ceiling(totalCount / (double)pageSize);
    private string? selectedType;
    private string? selectedStatus;
    private string search = string.Empty;
    private bool onlyEligible;

    private IReadOnlyList<QuizSelect.OptionDef> typeOptions = RewardCatalogs.TypeOptions.Select(o => new QuizSelect.OptionDef(o.Value, o.Label)).ToList();
    private IReadOnlyList<QuizSelect.OptionDef> statusOptions = RewardCatalogs.StatusOptions.Select(o => new QuizSelect.OptionDef(o.Value, o.Label)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        state = PageState.Loading;
        try
        {
            RewardsModels.RewardType? type = string.IsNullOrWhiteSpace(selectedType) ? null : RewardsModels.RewardTypeMap.FromApi(selectedType);
            if (!string.IsNullOrWhiteSpace(selectedType) && !RewardCatalogs.Types.Contains(selectedType, StringComparer.OrdinalIgnoreCase)) type = null;
            else if (!string.IsNullOrWhiteSpace(selectedType)) type = RewardsModels.RewardTypeMap.FromApi(selectedType);

            RewardsModels.RewardStateView? status = string.IsNullOrWhiteSpace(selectedStatus) ? null : RewardsModels.RewardStateMap.FromApi(selectedStatus);

            var filter = new RewardsModels.RewardFilter(Type: type, Status: status, Search: string.IsNullOrWhiteSpace(search) ? null : search, OnlyEligible: onlyEligible ? true : null, Page: currentPage, PageSize: pageSize);
            var result = await RewardsService.GetRewardsV2Async(filter);
            rewards = result.Items;
            totalCount = result.TotalCount;
            state = rewards.Count == 0 ? PageState.Empty : PageState.Ready;
        }
        catch (ApiErrorException ex)
        {
            if (ex.ErrorView.Code == "403" || ex.ErrorView.Title.Contains("Forbidden", StringComparison.OrdinalIgnoreCase))
                error = "Access Denied — no tiene permisos (GAME_MANAGER 403).";
            else error = ex.ErrorView.Detail ?? ex.ErrorView.Title;
            state = PageState.Error;
        }
        catch { error = "No se pudo cargar."; state = PageState.Error; }
    }

    private async Task OnTypeChanged(string? v) { selectedType = v; currentPage = 1; await LoadAsync(); }
    private async Task OnStatusChanged(string? v) { selectedStatus = v; currentPage = 1; await LoadAsync(); }
    private async Task OnEligibleChanged(ChangeEventArgs e) { onlyEligible = (bool)(e.Value ?? false); currentPage = 1; await LoadAsync(); }
    private async Task ChangePage(int p) { currentPage = p; await LoadAsync(); }

    private async Task Activate(RewardsModels.RewardSummary r)
    {
        try { await RewardsService.ActivateAsync(r.Id, r.RowVersion, Guid.NewGuid().ToString()); await LoadAsync(); Toasts.Success("Activado"); }
        catch (ApiErrorException ex) { Toasts.Error("Error", ex.ErrorView.Detail ?? ex.ErrorView.Title); }
    }
    private async Task Deactivate(RewardsModels.RewardSummary r)
    {
        try { await RewardsService.DeactivateAsync(r.Id, r.RowVersion, Guid.NewGuid().ToString()); await LoadAsync(); Toasts.Success("Desactivado"); }
        catch (ApiErrorException ex) { Toasts.Error("Error", ex.ErrorView.Detail ?? ex.ErrorView.Title); }
    }
}
