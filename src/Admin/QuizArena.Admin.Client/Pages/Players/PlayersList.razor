@page "/admin/players"
@attribute [Authorize(Policy = AdminPolicies.AnyAdminRole)]
@using PlayersModels = QuizArena.Admin.Client.Models.Players
@using QuizArena.Admin.Client.Services
@inject IPlayersService PlayersService
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Jugadores — QuizArena Admin</PageTitle>

<h1>Jugadores</h1>

<div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:end;margin-bottom:var(--space-4);">
    <QuizInput Id="player-search" Label="Buscar" Value="@search" ValueChanged="@(v => search = v ?? string.Empty)" Placeholder="Nombre, email o sub" />
    <QuizButton Variant="primary" OnClick="() => LoadAsync()" style="min-height:44px;min-width:44px;">Buscar</QuizButton>
    <QuizButton Variant="ghost" OnClick="Clear" style="min-height:44px;">Limpiar</QuizButton>
</div>

@if (state == PageState.Loading)
{
    <LoadingSkeleton Rows="6" />
}
else if (state == PageState.Error)
{
    <ErrorState Message="@error" OnRetry="LoadAsync" />
}
else if (players.Count == 0)
{
    <EmptyState Title="Sin jugadores" Message="No hay jugadores con esos filtros." />
}
else
{
    <QuizTable Caption="Jugadores" ColumnCount="5" IsEmpty="@(players.Count==0)">
        <HeaderCells><th>Nombre</th><th>Email</th><th>Tenant</th><th>Estado</th><th></th></HeaderCells>
        <BodyRows>
            @foreach (var p in players)
            {
                <tr>
                    <td>@p.DisplayName</td>
                    <td>@p.Email</td>
                    <td>@(p.TenantId ?? "—")</td>
                    <td><QuizBadge Variant="@(p.State==PlayersModels.PlayerStateView.Active?"success":p.State==PlayersModels.PlayerStateView.InGame?"info":p.State==PlayersModels.PlayerStateView.Withdrawn?"warning":"neutral")" Label="@PlayersModels.PlayerStateMap.DisplayName(p.State)" /></td>
                    <td><QuizButton Size="sm" Variant="ghost" OnClick='() => Navigation.NavigateTo($"/admin/players/{p.PlayerId}")' style="min-height:44px;">Ver</QuizButton></td>
                </tr>
            }
        </BodyRows>
    </QuizTable>
    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-4);flex-wrap:wrap;">
        <QuizButton Variant="ghost" Disabled="@(currentPage<=1)" OnClick="() => ChangePage(currentPage-1)" style="min-height:44px;">Anterior</QuizButton>
        <span aria-live="polite">Página @(currentPage) de @(totalPages) (@(totalCount) total)</span>
        <QuizButton Variant="ghost" Disabled="@(currentPage>=totalPages)" OnClick="() => ChangePage(currentPage+1)" style="min-height:44px;">Siguiente</QuizButton>
    </div>
}

@if (!string.IsNullOrWhiteSpace(correlationError))
{
    <div role="alert" aria-live="assertive" style="margin-top:var(--space-3);padding:var(--space-3);background:var(--color-warning);border-radius:var(--radius-md);">@correlationError</div>
}

@code {
    private enum PageState { Loading, Ready, Empty, Error }
    private PageState state = PageState.Loading;
    private string error = string.Empty;
    private string? correlationError;
    private IReadOnlyList<PlayersModels.PlayerSummary> players = [];
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages => pageSize<=0?0:(int)Math.Ceiling(totalCount/(double)pageSize);
    private string search = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        state = PageState.Loading;
        correlationError = null;
        try
        {
            var filter = new PlayersModels.PlayerFilter(Search: string.IsNullOrWhiteSpace(search) ? null : search.Trim(), Page: currentPage, PageSize: pageSize);
            var validation = filter.Validate();
            if (validation.Count>0)
            {
                error = string.Join("; ", validation.SelectMany(kv=>kv.Value));
                state = PageState.Error;
                return;
            }
            var result = await PlayersService.GetPlayersAsync(filter);
            players = result.Items;
            totalCount = result.TotalCount;
            state = players.Count==0 ? PageState.Empty : PageState.Ready;
        }
        catch (ApiErrorException ex)
        {
            if (ex.ErrorView.Code=="401" || ex.ErrorView.Title.Contains("Session", StringComparison.OrdinalIgnoreCase))
            {
                error = "Sesión expirada — re-autenticar. Filtros preservados.";
                correlationError = ex.ErrorView.Detail ?? ex.ErrorView.Title;
            }
            else if (ex.ErrorView.Code=="404")
            {
                error = "No se encontró el jugador.";
                players = [];
                state = PageState.Empty;
                return;
            }
            else if (ex.ErrorView.Code=="403")
            {
                error = "Access Denied — no tiene permisos (403).";
            }
            else
            {
                error = ex.ErrorView.Detail ?? ex.ErrorView.Title;
                correlationError = $"CorrelationId: {ex.ErrorView.Code}";
            }
            state = PageState.Error;
        }
        catch { error="No se pudo cargar."; state=PageState.Error; }
    }

    private async Task ChangePage(int p) { currentPage=p; await LoadAsync(); }
    private async Task Clear() { search=string.Empty; currentPage=1; await LoadAsync(); }
}
