@page "/admin/players/{PlayerId:guid}"
@attribute [Authorize(Policy = AdminPolicies.AnyAdminRole)]
@using PlayersModels = QuizArena.Admin.Client.Models.Players
@using QuizArena.Admin.Client.Services
@using QuizArena.Admin.Client.Shared.Players
@inject IPlayersService PlayersService
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Detalle jugador — QuizArena Admin</PageTitle>

@if (state == PageState.Loading)
{
    <LoadingSkeleton Rows="6" />
}
else if (state == PageState.Error)
{
    <ErrorState Message="@error" OnRetry="LoadAsync" />
}
else if (detail is null)
{
    <EmptyState Title="No encontrado" Message="Jugador no encontrado." />
}
else
{
    <div style="display:flex;gap:var(--space-3);align-items:center;margin-bottom:var(--space-4);flex-wrap:wrap;">
        <QuizButton Variant="ghost" OnClick='() => Navigation.NavigateTo("/admin/players")' style="min-height:44px;">← Volver</QuizButton>
        <h1 style="margin:0;">@detail.DisplayName</h1>
        <span style="color:var(--color-muted-foreground);font-size:var(--typography-caption);">@detail.PlayerId</span>
    </div>

    <PlayerProfileCard Detail="@detail" IsLoading="false" Error="@profileError" />

    <QuizTabs Tabs="tabs" ActiveId="activeTab" ActiveIdChanged="OnTabChanged" AriaLabel="Secciones del jugador">
        <ChildContent>
            @if (activeTab == "history")
            {
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:end;margin:var(--space-4) 0;">
                    <QuizInput Id="hist-search" Label="Buscar" Value="@histSearch" ValueChanged="@(v => histSearch = v ?? string.Empty)" Placeholder="Juego / categoría" />
                    <QuizSelect Id="hist-status" Label="Estado" Value="@histStatus" ValueChanged="OnHistStatus" Options="@gameStatusOptions" Placeholder="Todos" />
                    <QuizInput Id="hist-from" Label="Desde" Type="date" Value="@histFrom" ValueChanged="@(v => histFrom = v ?? string.Empty)" />
                    <QuizInput Id="hist-to" Label="Hasta" Type="date" Value="@histTo" ValueChanged="@(v => histTo = v ?? string.Empty)" />
                    <QuizButton Variant="primary" OnClick="LoadHistory" style="min-height:44px;">Filtrar</QuizButton>
                </div>
                @if (histState==SubState.Loading) { <LoadingSkeleton Rows="4" /> }
                else if (histState==SubState.Error) { <ErrorState Message="@histError" OnRetry="LoadHistory" /> }
                else if (histItems.Count==0) { <EmptyState Title="Sin historial" Message="No hay partidas con esos filtros." /> }
                else {
                    <QuizTable Caption="Historial" ColumnCount="6" IsEmpty="@(histItems.Count==0)">
                        <HeaderCells><th>Juego</th><th>Categoría</th><th>Estado</th><th>Rondas</th><th>Puntos</th><th>Rank</th></HeaderCells>
                        <BodyRows>
                            @foreach(var h in histItems){<tr><td>@h.GameName</td><td>@h.CategoryName</td><td><QuizBadge Variant="neutral" Label="@h.Status" /></td><td>@h.RoundCount</td><td>@(h.PlayerScore?.ToString() ?? "—")</td><td>@(h.PlayerRank?.ToString() ?? "—")</td></tr>}
                        </BodyRows>
                    </QuizTable>
                    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3);">
                        <QuizButton Variant="ghost" Disabled="@(histPage<=1)" OnClick="() => ChangeHistPage(histPage-1)" style="min-height:44px;">Anterior</QuizButton>
                        <span aria-live="polite">Página @(histPage) de @(histTotalPages) (@(histTotal) total)</span>
                        <QuizButton Variant="ghost" Disabled="@(histPage>=histTotalPages)" OnClick="() => ChangeHistPage(histPage+1)" style="min-height:44px;">Siguiente</QuizButton>
                    </div>
                }
            }
            else if (activeTab == "participations")
            {
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:end;margin:var(--space-4) 0;">
                    <QuizSelect Id="part-state" Label="Estado" Value="@partState" ValueChanged="OnPartState" Options="@participationOptions" Placeholder="Todos" />
                    <QuizInput Id="part-from" Label="Desde" Type="date" Value="@partFrom" ValueChanged="@(v => partFrom = v ?? string.Empty)" />
                    <QuizInput Id="part-to" Label="Hasta" Type="date" Value="@partTo" ValueChanged="@(v => partTo = v ?? string.Empty)" />
                    <QuizButton Variant="primary" OnClick="LoadParticipations" style="min-height:44px;">Filtrar</QuizButton>
                </div>
                @if (partStateState==SubState.Loading) { <LoadingSkeleton Rows="4" /> }
                else if (partStateState==SubState.Error) { <ErrorState Message="@partError" OnRetry="LoadParticipations" /> }
                else if (partItems.Count==0) { <EmptyState Title="Sin participaciones" Message="No hay participaciones." /> }
                else {
                    <QuizTable Caption="Participaciones" ColumnCount="5" IsEmpty="@(partItems.Count==0)">
                        <HeaderCells><th>Juego</th><th>Estado</th><th>Unido</th><th>GameStatus</th><th></th></HeaderCells>
                        <BodyRows>
                            @foreach(var p in partItems){<tr><td>@p.GameName</td><td><QuizBadge Variant="neutral" Label="@p.State" /></td><td>@p.JoinedAt.ToString("dd/MM/yyyy")</td><td>@p.GameStatus</td><td><QuizButton Size="sm" Variant="ghost" OnClick="() => LoadResult(p.GameId)" style="min-height:44px;">Resultado</QuizButton></td></tr>}
                        </BodyRows>
                    </QuizTable>
                    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3);">
                        <QuizButton Variant="ghost" Disabled="@(partPage<=1)" OnClick="() => ChangePartPage(partPage-1)" style="min-height:44px;">Anterior</QuizButton>
                        <span>Página @(partPage) de @(partTotalPages)</span>
                        <QuizButton Variant="ghost" Disabled="@(partPage>=partTotalPages)" OnClick="() => ChangePartPage(partPage+1)" style="min-height:44px;">Siguiente</QuizButton>
                    </div>
                    @if (result is not null){
                        <div style="margin-top:var(--space-4);padding:var(--space-4);background:var(--color-muted);border-radius:var(--radius-md);" role="region" aria-live="polite">
                            <h3>Resultado - Juego @result.GameId</h3>
                            <p>Total: @result.TotalScore | Asegurados: @result.SecuredScore | Rank: @result.Rank | Aciertos: @result.CorrectAnswers/@result.TotalAnswers | Duración: @result.Duration</p>
                        </div>
                    }
                }
            }
            else if (activeTab == "scores")
            {
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:end;margin:var(--space-4) 0;">
                    <QuizSelect Id="score-type" Label="Tipo" Value="@scoreType" ValueChanged="OnScoreType" Options="@transactionOptions" Placeholder="Todos" />
                    <QuizInput Id="score-from" Label="Desde" Type="date" Value="@scoreFrom" ValueChanged="@(v => scoreFrom = v ?? string.Empty)" />
                    <QuizInput Id="score-to" Label="Hasta" Type="date" Value="@scoreTo" ValueChanged="@(v => scoreTo = v ?? string.Empty)" />
                    <QuizButton Variant="primary" OnClick="LoadScores" style="min-height:44px;">Filtrar</QuizButton>
                </div>
                @if (scoresState==SubState.Loading) { <LoadingSkeleton Rows="4" /> }
                else if (scoresState==SubState.Error) { <ErrorState Message="@scoresError" OnRetry="LoadScores" /> }
                else if (scores.Count==0) { <EmptyState Title="Sin puntuaciones" Message="No hay transacciones." /> }
                else {
                    <div style="padding:var(--space-3);background:var(--color-card);border-radius:var(--radius-md);margin-bottom:var(--space-3);">
                        <strong>Total acumulado:</strong> @scoresTotalPoints pts (reconstruido desde ledger)
                    </div>
                    <QuizTable Caption="Puntuaciones" ColumnCount="5" IsEmpty="@(scores.Count==0)">
                        <HeaderCells><th>Tipo</th><th>Puntos</th><th>Fecha</th><th>Juego</th><th>Referencia</th></HeaderCells>
                        <BodyRows>
                            @foreach(var s in scores){<tr><td><QuizBadge Variant="neutral" Label="@PlayersModels.TransactionTypeMap.DisplayName(s.Type)" /></td><td style="color:@(s.Points<0?"var(--color-destructive-text)":"var(--color-success-text)")">@s.Points</td><td>@s.Timestamp.ToString("dd/MM/yyyy HH:mm")</td><td>@s.GameId.ToString()[..8]</td><td>@(s.ReferenceId?.ToString()[..8] ?? "—")</td></tr>}
                        </BodyRows>
                    </QuizTable>
                    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3);">
                        <QuizButton Variant="ghost" Disabled="@(scoresPage<=1)" OnClick="() => ChangeScoresPage(scoresPage-1)" style="min-height:44px;">Anterior</QuizButton>
                        <span>Página @(scoresPage) de @(scoresTotalPages)</span>
                        <QuizButton Variant="ghost" Disabled="@(scoresPage>=scoresTotalPages)" OnClick="() => ChangeScoresPage(scoresPage+1)" style="min-height:44px;">Siguiente</QuizButton>
                    </div>
                }
            }
            else if (activeTab == "rewards")
            {
                @if (redemptionsState==SubState.Loading) { <LoadingSkeleton Rows="4" /> }
                else if (redemptionsState==SubState.Error) { <ErrorState Message="@redemptionsError" OnRetry="LoadRedemptions" /> }
                else if (redemptions.Count==0) { <EmptyState Title="Sin canjes" Message="No hay canjes para este jugador." /> }
                else {
                    <QuizTable Caption="Canjes" ColumnCount="6" IsEmpty="@(redemptions.Count==0)">
                        <HeaderCells><th>Premio</th><th>Tipo</th><th>Costo</th><th>Estado</th><th>Consolación</th><th>Fecha</th></HeaderCells>
                        <BodyRows>
                            @foreach(var r in redemptions){<tr><td>@r.RewardName</td><td>@r.RewardType</td><td>@r.Cost</td><td><QuizBadge Variant="@(r.Status=="Approved"?"info":r.Status=="Delivered"?"success":"neutral")" Label="@r.Status" /></td><td>@(r.IsConsolation ? "Sí" : "No") @(r.IsConsolation? "": "")</td><td>@r.RequestedAt.ToString("dd/MM/yyyy")</td></tr>}
                        </BodyRows>
                    </QuizTable>
                    <div style="margin-top:var(--space-3);font-size:var(--typography-caption);color:var(--color-muted-foreground);">Consolación no cuenta como premio normal (IsConsolation:true)</div>
                    <div style="display:flex;gap:var(--space-3);align-items:center;margin-top:var(--space-3);">
                        <QuizButton Variant="ghost" Disabled="@(redemptionsPage<=1)" OnClick="() => ChangeRedemptionsPage(redemptionsPage-1)" style="min-height:44px;">Anterior</QuizButton>
                        <span>Página @(redemptionsPage) de @(redemptionsTotalPages)</span>
                        <QuizButton Variant="ghost" Disabled="@(redemptionsPage>=redemptionsTotalPages)" OnClick="() => ChangeRedemptionsPage(redemptionsPage+1)" style="min-height:44px;">Siguiente</QuizButton>
                    </div>
                }
            }
            else if (activeTab == "statistics")
            {
                @if (statsState==SubState.Loading) { <LoadingSkeleton Rows="4" /> }
                else if (statsState==SubState.Error) { <ErrorState Message="@statsError" OnRetry="LoadStatistics" /> }
                else if (statistics is null) { <EmptyState Title="Sin estadísticas" Message="No hay datos." /> }
                else {
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4);margin-bottom:var(--space-4);">
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Total juegos</strong><div style="font-size:var(--typography-heading-l);">@statistics.TotalGames</div></div>
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Victorias</strong><div style="font-size:var(--typography-heading-l);">@statistics.Wins</div><span style="font-size:var(--typography-caption);">Top3: @statistics.Top3</span></div>
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Promedio</strong><div style="font-size:var(--typography-heading-l);">@statistics.AverageScore.ToString("F1")</div></div>
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Precisión</strong><div style="font-size:var(--typography-heading-l);">@((statistics.AccuracyRate*100).ToString("F1"))%</div></div>
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Mejor racha</strong><div style="font-size:var(--typography-heading-l);">@statistics.BestStreak</div></div>
                        <div style="padding:var(--space-4);background:var(--color-card);border-radius:var(--radius-md);box-shadow:var(--shadow-sm);"><strong>Tiempo medio</strong><div style="font-size:var(--typography-heading-l);">@statistics.AverageTimePerQuestion.ToString(@"mm\:ss")</div></div>
                    </div>
                    <p style="font-size:var(--typography-caption);color:var(--color-muted-foreground);">Calculado: @statistics.CalculatedAt.ToString("dd/MM/yyyy HH:mm") (server-side, snapshot)</p>
                }
            }
        </ChildContent>
    </QuizTabs>
}

@code {
    [Parameter] public Guid PlayerId { get; set; }
    private enum PageState { Loading, Ready, Error }
    private enum SubState { Loading, Ready, Empty, Error }
    private PageState state = PageState.Loading;
    private string error = string.Empty;
    private PlayersModels.PlayerDetail? detail;
    private string? profileError;
    private string activeTab = "history";
    private List<QuizTabs.TabDef> tabs = [new("history","Historial"), new("participations","Participaciones"), new("scores","Puntuaciones"), new("rewards","Premios/Canjes"), new("statistics","Estadísticas")];

    // History
    private SubState histState = SubState.Loading;
    private string histError = string.Empty;
    private IReadOnlyList<PlayersModels.GameHistoryEntry> histItems = [];
    private int histPage=1; private int histTotal; private int histTotalPages => 20<=0?0:(int)Math.Ceiling(histTotal/(double)20);
    private string? histStatus; private string histSearch=""; private string histFrom=""; private string histTo="";
    private List<QuizSelect.OptionDef> gameStatusOptions = PlayerCatalogs.GameStatuses.Select(s=> new QuizSelect.OptionDef(s,s)).ToList();

    // Participations
    private SubState partStateState = SubState.Loading;
    private string partError=""; private IReadOnlyList<PlayersModels.PlayerParticipation> partItems=[];
    private int partPage=1; private int partTotal; private int partTotalPages => (int)Math.Ceiling(partTotal/(double)20);
    private string? partState; private string partFrom=""; private string partTo="";
    private List<QuizSelect.OptionDef> participationOptions = PlayerCatalogs.ParticipationStates.Select(s=> new QuizSelect.OptionDef(s,s)).ToList();
    private PlayersModels.PlayerResult? result;

    // Scores
    private SubState scoresState=SubState.Loading; private string scoresError=""; private IReadOnlyList<PlayersModels.PointTransactionView> scores=[];
    private int scoresPage=1; private int scoresTotal; private int scoresTotalPages => (int)Math.Ceiling(scoresTotal/(double)20);
    private string? scoreType; private string scoreFrom=""; private string scoreTo=""; private int scoresTotalPoints;
    private List<QuizSelect.OptionDef> transactionOptions = PlayerCatalogs.TransactionTypes.Select(s=> new QuizSelect.OptionDef(s,s)).ToList();

    // Redemptions
    private SubState redemptionsState=SubState.Loading; private string redemptionsError=""; private IReadOnlyList<PlayersModels.PlayerRedemptionView> redemptions=[];
    private int redemptionsPage=1; private int redemptionsTotal; private int redemptionsTotalPages => (int)Math.Ceiling(redemptionsTotal/(double)20);

    // Statistics
    private SubState statsState=SubState.Loading; private string statsError=""; private PlayersModels.PlayerStatistics? statistics;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        state=PageState.Loading;
        try {
            detail = await PlayersService.GetPlayerAsync(PlayerId);
            state=PageState.Ready;
            await LoadHistory();
            await LoadParticipations();
            await LoadScores();
            await LoadRedemptions();
            await LoadStatistics();
        } catch (ApiErrorException ex){ error=ex.ErrorView.Detail??ex.ErrorView.Title; state=PageState.Error; if(ex.ErrorView.Code=="403") profileError="Access Denied 403"; } catch{ error="No se pudo cargar."; state=PageState.Error; }
    }

    private async Task OnTabChanged(string id){ activeTab=id; }

    // History
    private async Task LoadHistory(){
        histState=SubState.Loading;
        try{
            DateTimeOffset? from = DateTimeOffset.TryParse(histFrom, out var fd)?fd:null;
            DateTimeOffset? to = DateTimeOffset.TryParse(histTo, out var td)?td:null;
            if(from.HasValue && to.HasValue && from.Value>to.Value){ histError="Desde debe ser ≤ Hasta."; histState=SubState.Error; return; }
            var filter = new PlayersModels.GameHistoryFilter(Search: string.IsNullOrWhiteSpace(histSearch)?null:histSearch, Status: histStatus, From: from, To: to, Page: histPage, PageSize: 20);
            var res = await PlayersService.GetPlayerGamesAsync(PlayerId, filter);
            histItems=res.Items; histTotal=res.TotalCount; histState=histItems.Count==0?SubState.Empty:SubState.Ready;
        } catch(ApiErrorException ex){ histError=ex.ErrorView.Detail??ex.ErrorView.Title; histState=SubState.Error; }
    }
    private async Task OnHistStatus(string? v){ histStatus=v; histPage=1; await LoadHistory(); }
    private async Task ChangeHistPage(int p){ histPage=p; await LoadHistory(); }

    // Participations
    private async Task LoadParticipations(){
        partStateState=SubState.Loading;
        try{
            DateTimeOffset? from = DateTimeOffset.TryParse(partFrom, out var fd)?fd:null;
            DateTimeOffset? to = DateTimeOffset.TryParse(partTo, out var td)?td:null;
            var filter = new PlayersModels.ParticipationFilter(State: partState, From: from, To: to, Page: partPage, PageSize: 20);
            var res = await PlayersService.GetParticipationsAsync(PlayerId, filter);
            partItems=res.Items; partTotal=res.TotalCount; partStateState=partItems.Count==0?SubState.Empty:SubState.Ready;
        } catch(ApiErrorException ex){ partError=ex.ErrorView.Detail??ex.ErrorView.Title; partStateState=SubState.Error; }
    }
    private async Task OnPartState(string? v){ partState=v; partPage=1; await LoadParticipations(); }
    private async Task ChangePartPage(int p){ partPage=p; await LoadParticipations(); }
    private async Task LoadResult(Guid gameId){
        try{ result = await PlayersService.GetResultAsync(PlayerId, gameId); } catch(ApiErrorException ex){ Toasts.Error("Error", ex.ErrorView.Detail??ex.ErrorView.Title); }
    }

    // Scores
    private async Task LoadScores(){
        scoresState=SubState.Loading;
        try{
            PlayersModels.TransactionType? type = string.IsNullOrWhiteSpace(scoreType)?null:PlayersModels.TransactionTypeMap.FromApi(scoreType);
            DateTimeOffset? from = DateTimeOffset.TryParse(scoreFrom, out var fd)?fd:null;
            DateTimeOffset? to = DateTimeOffset.TryParse(scoreTo, out var td)?td:null;
            var filter = new PlayersModels.ScoreFilter(Type: type, From: from, To: to, Page: scoresPage, PageSize: 20);
            var res = await PlayersService.GetScoresAsync(PlayerId, filter);
            scores=res.Items; scoresTotal=res.TotalCount; scoresTotalPoints=scores.Sum(s=>s.Points); scoresState=scores.Count==0?SubState.Empty:SubState.Ready;
        } catch(ApiErrorException ex){ scoresError=ex.ErrorView.Detail??ex.ErrorView.Title; scoresState=SubState.Error; }
    }
    private async Task OnScoreType(string? v){ scoreType=v; scoresPage=1; await LoadScores(); }
    private async Task ChangeScoresPage(int p){ scoresPage=p; await LoadScores(); }

    // Redemptions
    private async Task LoadRedemptions(){
        redemptionsState=SubState.Loading;
        try{
            var filter = new PlayersModels.RedemptionFilter(Page: redemptionsPage, PageSize: 20);
            var res = await PlayersService.GetRedemptionsAsync(PlayerId, filter);
            redemptions=res.Items; redemptionsTotal=res.TotalCount; redemptionsState=redemptions.Count==0?SubState.Empty:SubState.Ready;
        } catch(ApiErrorException ex){ redemptionsError=ex.ErrorView.Detail??ex.ErrorView.Title; redemptionsState=SubState.Error; }
    }
    private async Task ChangeRedemptionsPage(int p){ redemptionsPage=p; await LoadRedemptions(); }

    // Statistics
    private async Task LoadStatistics(){
        statsState=SubState.Loading;
        try{
            statistics = await PlayersService.GetStatisticsAsync(PlayerId);
            statsState=SubState.Ready;
        } catch(ApiErrorException ex){ statsError=ex.ErrorView.Detail??ex.ErrorView.Title; statsState=SubState.Error; }
    }
}
