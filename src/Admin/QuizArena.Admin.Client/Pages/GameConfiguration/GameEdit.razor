@page "/admin/games/{Id:guid}/edit"
@page "/admin/games/configuration/{Id:guid}"
@attribute [Authorize(Policy = AdminPolicies.AdminOrGameManager)]
@using GC = QuizArena.Admin.Client.Models.GameConfiguration
@using QuizArena.Admin.Client.Services
@using QuizArena.Admin.Client.Shared
@using QuizArena.Admin.Client.Shared.GameConfiguration
@inject IGameConfigurationService GameService
@inject NavigationManager Navigation

<PageTitle>Editar juego — QuizArena Admin</PageTitle>

@if (isLoading)
{
    <LoadingSkeleton Rows="6" />
}
else if (loadError is not null)
{
    <ErrorState Message="@loadError" OnRetry="LoadAsync" />
}
else if (form is not null && detail is not null)
{
    <h1>Editar juego: @detail.Name</h1>
    <GameStateBadge State="@detail.Status" />
    <p>RowVersion: @detail.RowVersion</p>

    <GameConfigurationForm Form="@form" FieldErrors="@fieldErrors" OnFieldChanged="HandleFieldChanged" OnSubmit="HandleUpdate" IsReadOnly="@isReadOnly" IsSubmitting="@isSubmitting" />

    @if (isReadOnly)
    {
        <div class="form-readonly-banner" role="alert">Edición bloqueada tras @detail.Status — configuración inmutable</div>
    }

    <GameTransitionsBar State="@detail.Status" RowVersion="@detail.RowVersion" OnTransition="HandleTransition" />

    @if (!string.IsNullOrEmpty(generalError))
    {
        <div class="validation-errors" role="alert">@generalError</div>
    }
}
else
{
    <EmptyState Title="No encontrado" Message="Juego no encontrado." />
}

@code {
    [Parameter] public Guid Id { get; set; }
    private GC.GameConfigurationForm? form;
    private GC.GameDetail? detail;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private string generalError = string.Empty;
    private Dictionary<string, string[]> fieldErrors = new();
    private bool isReadOnly => detail is not null && GC.GameStateViewMap.IsImmutable(detail.Status);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            detail = await GameService.GetAsync(Id);
            form = new GC.GameConfigurationForm(detail.Name, detail.Description, detail.CategoryId, detail.NumberOfRounds, detail.MaxPlayers, detail.TimePerQuestion, detail.InitialDifficulty, detail.DifficultyProgression, detail.Scoring, detail.PointsPerRound, detail.SecuredPoints, detail.WithdrawalPolicy, detail.FinishPolicy, detail.FinalRewardId, detail.ConsolationRewardId, detail.ScheduledAt);
        }
        catch (ApiErrorException ex)
        {
            loadError = ex.ErrorView.Detail ?? ex.ErrorView.Title;
        }
        finally { isLoading = false; }
    }

    private Task HandleFieldChanged((string Field, string Value) args)
    {
        if (form is null) return Task.CompletedTask;
        var (field, value) = args;
        form = field switch
        {
            nameof(GC.GameConfigurationForm.Name) => form with { Name = value },
            nameof(GC.GameConfigurationForm.Description) => form with { Description = string.IsNullOrWhiteSpace(value) ? null : value },
            nameof(GC.GameConfigurationForm.CategoryId) when Guid.TryParse(value, out var g) => form with { CategoryId = g },
            nameof(GC.GameConfigurationForm.NumberOfRounds) when int.TryParse(value, out var n) => form with { NumberOfRounds = n },
            nameof(GC.GameConfigurationForm.MaxPlayers) when int.TryParse(value, out var n) => form with { MaxPlayers = n },
            nameof(GC.GameConfigurationForm.TimePerQuestion) when int.TryParse(value, out var n) => form with { TimePerQuestion = n },
            nameof(GC.GameConfigurationForm.InitialDifficulty) when int.TryParse(value, out var n) => form with { InitialDifficulty = n },
            nameof(GC.GameConfigurationForm.DifficultyProgression) when Enum.TryParse<GC.DifficultyStrategy>(value, out var v) => form with { DifficultyProgression = v },
            nameof(GC.GameConfigurationForm.Scoring) when Enum.TryParse<GC.ScoringSystem>(value, out var v) => form with { Scoring = v },
            nameof(GC.GameConfigurationForm.SecuredPoints) when Enum.TryParse<GC.SecuredPointsPolicy>(value, out var v) => form with { SecuredPoints = v },
            nameof(GC.GameConfigurationForm.WithdrawalPolicy) when Enum.TryParse<GC.WithdrawalPolicy>(value, out var v) => form with { WithdrawalPolicy = v },
            nameof(GC.GameConfigurationForm.FinishPolicy) when Enum.TryParse<GC.LossPolicy>(value, out var v) => form with { FinishPolicy = v },
            nameof(GC.GameConfigurationForm.FinalRewardId) => form with { FinalRewardId = string.IsNullOrWhiteSpace(value) ? null : Guid.TryParse(value, out var g2) ? g2 : null },
            nameof(GC.GameConfigurationForm.ConsolationRewardId) => form with { ConsolationRewardId = string.IsNullOrWhiteSpace(value) ? null : Guid.TryParse(value, out var g2) ? g2 : null },
            nameof(GC.GameConfigurationForm.ScheduledAt) when DateTimeOffset.TryParse(value, out var dto) => form with { ScheduledAt = dto },
            _ => form
        };
        if (field == nameof(GC.GameConfigurationForm.ScheduledAt) && string.IsNullOrWhiteSpace(value) && form is not null) form = form with { ScheduledAt = null };
        return Task.CompletedTask;
    }

    private async Task HandleUpdate(GC.GameConfigurationForm _)
    {
        if (form is null || detail is null) return;
        if (isReadOnly)
        {
            generalError = "Configuración inmutable tras Ready/Running — no se puede editar.";
            return;
        }
        fieldErrors.Clear();
        generalError = string.Empty;
        var validation = form.Validate();
        if (validation.Count > 0) { fieldErrors = new(validation); return; }
        isSubmitting = true;
        try
        {
            var req = new GC.UpdateGameRequest(form.Name, form.Description, form.CategoryId, form.NumberOfRounds, form.MaxPlayers, form.TimePerQuestion, form.InitialDifficulty, form.DifficultyProgression, form.Scoring, form.PointsPerRound, form.SecuredPoints, form.WithdrawalPolicy, form.FinishPolicy, form.FinalRewardId, form.ConsolationRewardId, form.ScheduledAt, detail.RowVersion);
            detail = await GameService.UpdateAsync(Id, req);
            Navigation.NavigateTo($"/admin/games/{Id}");
        }
        catch (ApiErrorException ex)
        {
            if (ex.ErrorView.Code == "ConcurrencyConflict")
                generalError = "Conflicto de concurrencia — recargue.";
            else if (ex.ErrorView.Code == "InvalidGameState")
                generalError = "Estado inválido — configuración inmutable.";
            else
            {
                if (ex.ErrorView.FieldErrors is not null) fieldErrors = new(ex.ErrorView.FieldErrors);
                generalError = ex.ErrorView.Detail ?? ex.ErrorView.Title;
            }
        }
        finally { isSubmitting = false; }
    }

    private async Task HandleTransition((GC.GameStateView To, string RowVersion) args)
    {
        if (detail is null) return;
        try
        {
            detail = args.To switch
            {
                GC.GameStateView.Scheduled when form?.ScheduledAt is not null => await GameService.ScheduleAsync(Id, form.ScheduledAt.Value, args.RowVersion),
                GC.GameStateView.Ready => await GameService.ReadyAsync(Id, args.RowVersion),
                GC.GameStateView.Running => await GameService.StartAsync(Id, args.RowVersion),
                GC.GameStateView.Paused => await GameService.PauseAsync(Id, args.RowVersion),
                GC.GameStateView.Finished => await GameService.FinishAsync(Id, args.RowVersion),
                GC.GameStateView.Cancelled => await GameService.CancelAsync(Id, args.RowVersion),
                _ when args.To == GC.GameStateView.Running && detail.Status == GC.GameStateView.Paused => await GameService.ResumeAsync(Id, args.RowVersion),
                _ => detail
            };
            StateHasChanged();
        }
        catch (ApiErrorException ex)
        {
            generalError = ex.ErrorView.Detail ?? ex.ErrorView.Title;
        }
    }
}
