@page "/admin/categories/list"
@attribute [Authorize(Policy = AdminPolicies.AdminOrGameManager)]
@using GC = QuizArena.Admin.Client.Models.Categories
@using QuizArena.Admin.Client.Services
@using QuizArena.Admin.Client.Shared.Categories
@inject ICategoriesService CategoriesService
@inject NavigationManager Navigation

<PageTitle>Categorías — QuizArena Admin</PageTitle>

<div class="page-header">
    <h1>Categorías</h1>
    <QuizButton Icon="plus" OnClick="GoCreate">Nueva categoría</QuizButton>
</div>

<div class="toolbar">
    <QuizSelect Id="filter-status" Label="Estado" Value="@selectedStatus" ValueChanged="OnStatusChanged" Options="@statusOptions" Placeholder="Todos" />
    <QuizInput Id="filter-area" Label="Área" Placeholder="Matemáticas, Ciencia…" Value="@selectedArea" ValueChanged="OnAreaChanged" />
    <QuizInput Id="filter-search" Label="Buscar" Placeholder="Nombre…" Value="@search" ValueChanged="OnSearchChanged" />
</div>

@if (state == PageState.Loading)
{
    <LoadingSkeleton Rows="3" />
}
else if (state == PageState.Error)
{
    <ErrorState Message="@error" OnRetry="LoadAsync" />
}
else if (categories is not null)
{
    <QuizTable Caption="Categorías" ColumnCount="5" Loading="false" Page="@currentPage" TotalPages="@totalPages" PageChanged="OnPageChanged">
        <HeaderCells><th>Nombre</th><th>Área</th><th>Estado</th><th>Preguntas</th><th></th></HeaderCells>
        <BodyRows>
            @foreach (var c in categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.KnowledgeArea</td>
                    <td><CategoryStateBadge State="@MapState(c.Status)" ValidQuestionCount="@c.ValidQuestionCount" /></td>
                    <td>@c.ValidQuestionCount</td>
                    <td><a href="@($"/admin/categories/{c.Id}")">Detalle</a> | <a href="@($"/admin/categories/{c.Id}/edit")">Editar</a></td>
                </tr>
            }
        </BodyRows>
    </QuizTable>
    <p>Total: @totalCount categorías</p>
}
else
{
    <EmptyState Title="Sin categorías" Message="No hay categorías." />
}

@code {
    private enum PageState { Loading, Ready, Error, Empty }
    private PageState state = PageState.Loading;
    private string error = string.Empty;
    private IReadOnlyList<QuizArena.Admin.Client.Models.CategorySummary>? categories;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private string? selectedStatus;
    private string? selectedArea;
    private string? search;
    private IReadOnlyList<QuizSelect.OptionDef> statusOptions = [new("Draft","Draft"), new("Active","Active"), new("Inactive","Inactive"), new("Archived","Archived")];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        state = PageState.Loading;
        try
        {
            var filter = new QuizArena.Admin.Client.Models.CategoryFilter(
                Status: string.IsNullOrWhiteSpace(selectedStatus) ? null : Enum.Parse<QuizArena.Admin.Client.Models.CategoryStatusView>(selectedStatus),
                Page: currentPage);
            var result = await CategoriesService.GetCategoriesAsync(filter);
            var items = result.Items;
            // client-side area/search filter for 020 (8 ejemplos)
            if (!string.IsNullOrWhiteSpace(selectedArea))
                items = items.Where(c => c.KnowledgeArea.Contains(selectedArea, StringComparison.OrdinalIgnoreCase)).ToList();
            if (!string.IsNullOrWhiteSpace(search))
                items = items.Where(c => c.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            categories = items;
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            state = categories.Count == 0 ? PageState.Empty : PageState.Ready;
        }
        catch (ApiErrorException ex) { error = ex.ErrorView.Detail ?? ex.ErrorView.Title; state = PageState.Error; }
    }

    private GC.CategoryStateView MapState(QuizArena.Admin.Client.Models.CategoryStatusView s) => s switch
    {
        QuizArena.Admin.Client.Models.CategoryStatusView.Active => GC.CategoryStateView.Active,
        QuizArena.Admin.Client.Models.CategoryStatusView.Inactive => GC.CategoryStateView.Inactive,
        QuizArena.Admin.Client.Models.CategoryStatusView.Archived => GC.CategoryStateView.Archived,
        _ => GC.CategoryStateView.Draft
    };

    private void GoCreate(Microsoft.AspNetCore.Components.Web.MouseEventArgs _) => Navigation.NavigateTo("/admin/categories/new");
    private Task OnStatusChanged(string? v) { selectedStatus = v; currentPage = 1; return LoadAsync(); }
    private Task OnAreaChanged(string? v) { selectedArea = v; currentPage = 1; return LoadAsync(); }
    private Task OnSearchChanged(string? v) { search = v; currentPage = 1; return LoadAsync(); }
    private Task OnPageChanged(int p) { currentPage = p; return LoadAsync(); }
}
